{
  "name": "web-bml",
  "version": "1.0.1",
  "main": "./dist/client/bml_browser.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w"
  },
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/client/bml_browser.d.ts",
      "default": "./dist/client/bml_browser.js"
    },
    "./entity-parser": {
      "types": "./dist/server/entity_parser.d.ts",
      "default": "./dist/server/entity_parser.js"
    },
    "./ts": {
      "types": "./dist/server/decode_ts.d.ts",
      "default": "./dist/server/decode_ts.js"
    },
    "./protocol": {
      "types": "./dist/server/ws_api.d.ts",
      "default": "./dist/server/ws_api.js"
    }
  },
  "dependencies": {
    "arib-mmt-tlv-ts": "^2.0.2",
    "crc-32": "^1.2.2",
    "css": "https://github.com/otya128/reworkcss-css/releases/download/v3.0.2/css-3.0.2.tgz",
    "fast-xml-parser": "^4.0.11",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/css": "^0.0.38",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3"
  },
  "workspaces": [
    "example",
    "fonts"
  ]
}
